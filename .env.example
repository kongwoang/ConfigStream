# Local plaintext Kafka only. Export these values before running Python commands.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLIENT_ID=configstream-generator
KAFKA_DELIVERY_TIMEOUT_MS=10000
KAFKA_FLUSH_TIMEOUT_SECONDS=15
KAFKA_ENQUEUE_TIMEOUT_SECONDS=5
# Spark local mode; install with make spark-setup and provide Java 21.
SPARK_MASTER=local[*]
SPARK_APP_NAME=ConfigStreamStreaming
SPARK_CHECKPOINT_DIR=.cache/spark-checkpoints/config-snapshots
SPARK_RUNTIME_DIR=.cache/spark
SPARK_STARTING_OFFSETS=latest
SPARK_TRIGGER_SECONDS=2
SPARK_MAX_OFFSETS_PER_TRIGGER=10000
SPARK_CONSOLE_ROWS=20
# Makefile already defaults to these project-local tool directories.
UV_CACHE_DIR=.cache/uv
UV_PYTHON_INSTALL_DIR=.tools/python
# Future service configuration belongs in environment variables, never in source.
# Do not commit .env or real credentials. This file is not loaded automatically.
